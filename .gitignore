# Machine-local state lives in ~/.config/chezmoi/chezmoi.toml, never here.
.DS_Store
dot_DS_Store
*.swp
*~
.idea/
.vscode/
*.log
.chezmoidata/

# Never commit key material or secrets (public repo); public keys are allowed.
**/*id_*
!**/*id_*.pub
!**/*id_*.pub.tmpl
*.pem
*.key
*.p12
*.kdbx
.env
.env.*
*.ppk
*.age
*credentials*
*netrc*
**/dot_kube/
**/private_dot_kube/
**/*_key
!**/*_key.pub

# Claude Code: track only hand-written config; transcripts, history and
# ~/.claude.json hold code, prompts and account data.
config/dot_config/private_claude/*
!config/dot_config/private_claude/settings.json
!config/dot_config/private_claude/plugins/
config/dot_config/private_claude/plugins/*
!config/dot_config/private_claude/plugins/claude-hud/
config/dot_config/private_claude/plugins/claude-hud/*
!config/dot_config/private_claude/plugins/claude-hud/config.json
