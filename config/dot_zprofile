# Set PATH, MANPATH, etc., for Homebrew, unless /etc/zprofile already did
# (some managed Macs add it there).
[[ "$(</etc/zprofile)" == *'brew shellenv'* ]] 2>/dev/null || eval "$(/opt/homebrew/bin/brew shellenv)"
# brew shellenv exports FPATH: child shells (tmux panes, nvim :terminal) then inherit the
# parent's full fpath, oh-my-zsh's "#omz fpath" check in .zcompdump never matches between
# them, and compinit rebuilt the dump on every switch (~0.7s). zshrc adds brew's completions.
typeset +x FPATH
