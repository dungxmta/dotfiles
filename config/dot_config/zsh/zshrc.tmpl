{{- /* Rendered per machine by chezmoi. Mac and Linux branches keep each machine's
     previous zshrc; has-checks only drop lines for tools deselected in ./install.sh. */ -}}
{{- $mac := eq .chezmoi.os "darwin" -}}
{{- $t := .tools -}}
# Save history to a file (asked by ./install.sh, change with `dot sync zsh`):
# no  = history in memory only; commands you keep with `hkeep` are loaded from
#       ~/.history/zsh; python/less/node REPL history off.
# yes = oh-my-zsh defaults (~/.zsh_history). Per-shell override: ZSH_SAVE_HISTORY=yes zsh
# (REPL vars are exported: a nested yes shell inherits them; use `env -u PYTHON_HISTORY -u LESSHISTFILE -u NODE_REPL_HISTORY`).
: ${ZSH_SAVE_HISTORY:={{ if get . "zshSaveHistory" }}yes{{ else }}no{{ end }}}
# Agent history: on = Claude Code and omp save no prompt history or session transcripts
# (no --resume/--continue; omp still keeps typed prompts in ~/.omp/agent/history.db).
# off = their defaults. Per-shell override: AGENT_EPHEMERAL=off zsh. Wipe saved history: agent clear history
: ${AGENT_EPHEMERAL:=on}
{{- if not $mac }}

# No terminfo for $TERM here (e.g. xterm-ghostty via limactl shell/ssh) garbles line
# editing; fall back to a common entry. Better: copy it from the Mac once:
#   infocmp -x xterm-ghostty | limactl shell NAME -- tic -x -
(( $+commands[infocmp] )) && ! infocmp "$TERM" >/dev/null 2>&1 && export TERM=xterm-256color
{{- end }}

# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time oh-my-zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="" # prompt: Starship (below)

# Set list of themes to pick from when loading at random
# Setting this variable when ZSH_THEME=random will cause zsh to load
# a theme from this variable instead of looking in $ZSH/themes/
# If set to an empty array, this variable will have no effect.
# ZSH_THEME_RANDOM_CANDIDATES=( "robbyrussell" "agnoster" )

# Uncomment the following line to use case-sensitive completion.
# CASE_SENSITIVE="true"

# Uncomment the following line to use hyphen-insensitive completion.
# Case-sensitive completion must be off. _ and - will be interchangeable.
# HYPHEN_INSENSITIVE="true"

# Uncomment one of the following lines to change the auto-update behavior
zstyle ':omz:update' mode disabled  # no self-update: plugins are pinned, ./install.sh --upgrade moves them
# zstyle ':omz:update' mode auto      # update automatically without asking
# zstyle ':omz:update' mode reminder  # pinned (detached) checkouts always look outdated: git calls + a nag every shell

# Uncomment the following line to change how often to auto-update (in days).
# zstyle ':omz:update' frequency 7

# Uncomment the following line if pasting URLs and other text is messed up.
# DISABLE_MAGIC_FUNCTIONS="true"

# Uncomment the following line to disable colors in ls.
# DISABLE_LS_COLORS="true"

# Uncomment the following line to disable auto-setting terminal title.
# DISABLE_AUTO_TITLE="true"

# Uncomment the following line to enable command auto-correction.
# ENABLE_CORRECTION="true"

# Uncomment the following line to display red dots whilst waiting for completion.
# You can also set it to another string to have that shown instead of the default red dots.
# e.g. COMPLETION_WAITING_DOTS="%F{yellow}waiting...%f"
# Caution: this setting can cause issues with multiline prompts in zsh < 5.7.1 (see #5765)
# COMPLETION_WAITING_DOTS="true"

# Uncomment the following line if you want to disable marking untracked files
# under VCS as dirty. This makes repository status check for large repositories
# much, much faster.
# DISABLE_UNTRACKED_FILES_DIRTY="true"

# Uncomment the following line if you want to change the command execution time
# stamp shown in the history command output.
# You can set one of the optional three formats:
# "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd"
# or set a custom format using the strftime function format specifications,
# see 'man strftime' for details.
# HIST_STAMPS="mm/dd/yyyy"

# Would you like to use another custom folder than $ZSH/custom?
# ZSH_CUSTOM=/path/to/new-custom-folder

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(git zsh-autosuggestions zsh-syntax-highlighting zsh-vi-mode)

# zsh-vi-mode (read when the plugin loads): visual selection and yank flash in the colours
# of nvim's kanagawa and tmux copy mode (tmux.conf: mode-style, @yank_flash_style):
# selection #223249, the yanked text flashes #2D4F67 with light text (zvm_yank below).
# Compare options in this terminal: scripts/yank-colors.sh in the dotfiles repo.
# y also copies to the system clipboard; p still pastes zsh-vi-mode's own register.
ZVM_VI_HIGHLIGHT_BACKGROUND='#223249'
ZVM_VI_HIGHLIGHT_FOREGROUND=default
ZSH_YANK_FLASH_STYLE='fg=#DCD7BA,bg=#2D4F67'
# hex colours need truecolor; without COLORTERM (e.g. tmux over ssh) use the nearest of 256
[[ $COLORTERM == (truecolor|24bit) ]] || zmodload zsh/nearcolor
ZVM_SYSTEM_CLIPBOARD_ENABLED=true
{{- if not $mac }}
# no pbcopy here: osc52 (aliases.sh) to the terminal; tmux's set-clipboard passes it to the
# Mac. zsh-vi-mode wants a paste command too but never runs it.
ZVM_CLIPBOARD_COPY_CMD='osc52 >/dev/tty'
ZVM_CLIPBOARD_PASTE_CMD='tmux save-buffer -'
{{- end }}
{{- if $mac }}

# Homebrew completions in non-login shells too (nvim :terminal, `zsh`): ~/.zprofile adds
# them but no longer exports FPATH. Same position as there, so .zcompdump stays valid.
_brew_fpath=${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh/site-functions
(( ${fpath[(Ie)$_brew_fpath]} )) || fpath=($_brew_fpath $fpath)
unset _brew_fpath
{{- end }}

fpath+=${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src
fpath=("$HOME/.config/zsh/completions" $fpath) # _dot, _vm (Mac); before compinit in oh-my-zsh
{{- if eq .profile "mac-work" }}
# /opt/homebrew belongs to the IT admin account, so compaudit flags its completions as
# insecure and the counts in .zcompdump never match: compinit rebuilt it every shell (~0.6s).
ZSH_DISABLE_COMPFIX=true
{{- end }}

# cache for slow generated init (kubectl completion, macOS SDK path, tool init scripts)
_zsh_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d $_zsh_cache ]] || mkdir -p "$_zsh_cache"

# Cache the init script a tool prints (`_cached_init direnv hook zsh && source $REPLY`).
# Regenerated when the tool's resolved path changes (a Homebrew upgrade moves it to a
# new Cellar dir), the binary is newer than the cache, or on reload-zsh
# ($_zsh_cache_refresh, which also regenerates the other entries). Only for output that doesn't
# depend on the environment: not `mise activate`, which embeds the current PATH.
# Sourced by the caller so the script's typeset/setopt run at top level.
_cached_init() {
  local bin=${commands[$1]:A} line
  REPLY="$_zsh_cache/$1-init.zsh"
  [[ -n $bin ]] || return 1
  [[ -s $REPLY ]] && read -r line <"$REPLY"
  if [[ -n $_zsh_cache_refresh || $line != "# $bin" || $REPLY -ot $bin ]]; then
    { print -r -- "# $bin" && "$@" } >|"$REPLY" || { : >|"$REPLY"; return 1 }
  fi
}
{{- if has "mise" $t }}

## tool version manager: activate before oh-my-zsh so later hooks find mise's binaries
eval "$(mise activate zsh)"
{{- end }}

## nvim jdtls launcher JDK (needs Java 25+). Not needed by default: java.lua finds
## it in the mise install dir. Set only if that JDK lives outside mise (e.g. Homebrew).
## Don't set JAVA_HOME here: mise activate sets it per project.
# export JDTLS_JAVA_HOME="/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home"

source $ZSH/oh-my-zsh.sh

## history (flag ZSH_SAVE_HISTORY at top of file)
ZSH_HKEEP_FILE="$HOME/.history/zsh"
if [[ $ZSH_SAVE_HISTORY == no ]]; then
  unset HISTFILE
  SAVEHIST=0
  [[ -r $ZSH_HKEEP_FILE ]] && fc -R "$ZSH_HKEEP_FILE"
  export PYTHON_HISTORY=/dev/null LESSHISTFILE=- NODE_REPL_HISTORY=''
fi

# hkeep file (~/.history/zsh). hkeep: menu; -l the previous command, -p pick this session's
# commands (fzf), -d pick kept commands to delete (fzf). The file stores a multi-line
# command as lines ending in "\", which is what fc -R reads back.

# reply: the kept commands, one element per command.
_hkeep_entries() {
  reply=()
  local line cur more=0
  [[ -r $ZSH_HKEEP_FILE ]] || return 0
  while IFS= read -r line; do
    (( more )) && cur+=$'\n' || cur=
    if [[ $line == *\\ ]]; then
      cur+=${line%\\} more=1
    else
      cur+=$line more=0
      reply+=("$cur")
    fi
  done <"$ZSH_HKEEP_FILE"
  (( more )) && reply+=("$cur")
  return 0
}

# reply: this session's commands not kept yet, newest first, each once.
_hkeep_new() {
  local n c
  local -a kept
  local -aU new
  _hkeep_entries
  kept=("${reply[@]}")
  for n in ${(Onk)history}; do
    c=${history[$n]}
    [[ $c == hkeep(| *) ]] || (( ${kept[(Ie)$c]} )) || new+=("$c")
  done
  reply=("${new[@]}")
}

# Append command $1 to the file unless it is kept already.
_hkeep_write() {
  local file=$ZSH_HKEEP_FILE nl=$'\n'
  _hkeep_entries
  if (( ${reply[(Ie)$1]} )); then
    print -r -- "hkeep: already kept: $1"
    return 0
  fi
  [[ -d ${file:h} ]] || mkdir -m 700 -p -- "${file:h}"
  (umask 077; print -r -- "${1//$nl/\\$nl}" >>"$file")
  print -r -- "hkeep: kept: $1"
}

# fzf over the commands in reply (multi-line ones stay whole); reply: the picked ones.
_hkeep_pick() {
  local out
  out=$(print -rN -- "${reply[@]}" | fzf --read0 --print0 --multi --height=~50% --reverse \
    --prompt="$1> " --header="Tab: select several · Enter: $1") || { reply=(); return 1 }
  reply=("${(@0)out}")
  reply=("${(@)reply:#}")
}

hkeep() {
  local file=$ZSH_HKEEP_FILE nl=$'\n' prev=${history[$((HISTCMD - 1))]} c key
  [[ $prev == hkeep(| *) ]] && prev=
  case $1 in
    -l)
      [[ -n $prev ]] || { print -u2 "hkeep: no previous command to keep"; return 1 }
      _hkeep_write "$prev"
      ;;
    -p)
      (( $+commands[fzf] )) || { print -u2 "hkeep: -p needs fzf"; return 1 }
      _hkeep_new
      (( $#reply )) || { print "hkeep: nothing new to keep"; return 0 }
      _hkeep_pick keep || return 0
      for c in "${reply[@]}"; do _hkeep_write "$c"; done
      ;;
    -d)
      (( $+commands[fzf] )) || { print -u2 "hkeep: -d needs fzf"; return 1 }
      _hkeep_entries
      local -a all=("${reply[@]}") rest
      (( $#all )) || { print "hkeep: nothing kept yet"; return 0 }
      _hkeep_pick delete || return 0
      (( $#reply )) || return 0
      for c in "${all[@]}"; do (( ${reply[(Ie)$c]} )) || rest+=("$c"); done
      # temp file + rename: a failed write never truncates the kept history
      (umask 077; for c in "${rest[@]}"; do print -r -- "${c//$nl/\\$nl}"; done >|"$file.$$") &&
        mv -f -- "$file.$$" "$file" || { rm -f -- "$file.$$"; return 1 }
      print -r -- "hkeep: deleted $(( $#all - $#rest ))"
      ;;
    '')
      _hkeep_new
      [[ $prev == *$nl* ]] && c=' …'
      local -a menu=(
        "p  previous command   ${${prev%%$nl*}:-(none)}$c"
        "s  session commands   pick from $#reply not kept yet"
        "r  remove kept        pick kept lines to delete"
      )
      if (( $+commands[fzf] )); then
        # one key picks (no search box); ↑↓ Enter works too
        key=$(print -rl -- $menu | fzf --no-input --reverse --height=~10 \
          --header='p / s / r, or ↑↓ Enter · q / Esc: quit' \
          --bind 'p:become(echo p),s:become(echo s),r:become(echo r),q:abort') || return 0
        key=${key[1]}
      else
        print -rl -- "  "${^menu}
        print -n -- "? [p/s/r, Enter = p, q = quit] "
        read -k1 key
        [[ $key == $'\n' ]] || print
      fi
      case $key in
        p|$'\n') hkeep -l ;;
        s) hkeep -p ;;
        r) hkeep -d ;;
      esac
      ;;
    *) print -u2 "usage: hkeep [-l | -p | -d]"; return 2 ;;
  esac
}

## prompt marks (OSC 133) for tmux: A where each prompt starts, C where a command's output
## starts; tmux prefix C-y copies the last output with them. Only in tmux: other terminals
## (Ghostty, Warp) have their own shell integration.
if [[ -n $TMUX ]]; then
  autoload -Uz add-zsh-hook
  _osc133_prompt() { print -n '\e]133;A\e\\' }
  _osc133_output() { print -n '\e]133;C\e\\' }
  add-zsh-hook precmd _osc133_prompt
  add-zsh-hook preexec _osc133_output
fi

## agents (flag AGENT_EPHEMERAL at top of file)
if [[ $AGENT_EPHEMERAL == on ]]; then
  export CLAUDE_CODE_SKIP_PROMPT_HISTORY=1
  omp() { command omp --no-session "$@"; }
else
  unset CLAUDE_CODE_SKIP_PROMPT_HISTORY
  (( $+functions[omp] )) && unfunction omp
fi

# Key bindings: zsh-vi-mode initializes lazily and resets bindings, so apply
# ours from its after-init hook (or right away when the plugin is missing).
_my_bindkeys() {
  # ^w keeps the default backward-kill-word (delete the previous word); ^e then Enter runs a suggestion
  bindkey '^e' autosuggest-accept
  bindkey '^u' autosuggest-toggle
  bindkey '^L' vi-forward-word
  bindkey '^k' up-line-or-search
  bindkey '^j' down-line-or-search
  # fzf history search (fzf.zsh, sourced below), also reset by zsh-vi-mode
  (( $+functions[fzf-history-widget] )) && bindkey '^r' fzf-history-widget
}
if (( $+functions[zvm_init] )); then
  zvm_after_init_commands+=(_my_bindkeys)
else
  _my_bindkeys
fi

# zsh-vi-mode: flash what a yank took (visual y, yy, yw, ...) for 0.15s in ZSH_YANK_FLASH_STYLE
# (top of the zsh-vi-mode settings; colour options: scripts/yank-colors.sh), like nvim's
# highlight-on-yank.
# Every yank goes through zvm_yank, which leaves the range in CURSOR..MARK. Keys typed
# during the flash wait, they aren't lost. Skipped if a plugin update renames zvm_yank.
if (( $+functions[zvm_yank] && ! $+functions[_zvm_yank_orig] )); then
  zmodload zsh/zselect
  functions[_zvm_yank_orig]=$functions[zvm_yank]
  zvm_yank() {
    _zvm_yank_orig "$@"
    local -a lit=("${region_highlight[@]}")
    region_highlight+=("$CURSOR $MARK $ZSH_YANK_FLASH_STYLE")
    zle -R
    zselect -t 15
    region_highlight=("${lit[@]}")
  }
fi

