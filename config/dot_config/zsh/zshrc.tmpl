# Set personal aliases, overriding those provided by oh-my-zsh libs,
# plugins, and themes. Aliases can be placed here, though oh-my-zsh
# users are encouraged to define aliases within the ZSH_CUSTOM folder.
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"

##
# CUSTOM CONFIG
##

#source ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh
# machine-local, never in git (work aliases, kube contexts); created empty by chezmoi
source ~/.config/zsh/private.zsh
{{- if $mac }}

# Lima VM management
source "$HOME/.config/zsh/lima-vm.zsh"
{{- end }}
{{- if .dotEnabled }}

# dot: chezmoi/dotfiles helper (enabled in ./install.sh)
source "$HOME/.config/zsh/dot.zsh"
{{- end }}

# agent: helper from the separate agents repo, when installed (~/SYNC/agents/install.sh)
[[ -r "$HOME/.config/zsh/agent.zsh" ]] && source "$HOME/.config/zsh/agent.zsh"

## aliases and functions shared with other shells
source "$HOME/.config/shell/common/aliases.sh"
# reload config, regenerating everything in the cache above (an alias, not a function,
# so zshrc is sourced at top level and its typesets stay global)
alias reload-zsh='_zsh_cache_refresh=1; source ~/.zshrc; unset _zsh_cache_refresh; (( $+functions[_dot_index] )) && _dot_index -q'
# same refresh in a new login shell (exec, same terminal): also re-runs ~/.zprofile and drops
# old functions, variables and exports, but this session's history goes (ZSH_SAVE_HISTORY=no).
# The flag goes through the environment; the end of this file unsets it.
alias restart-zsh='_zsh_cache_refresh=1 exec zsh -l'
export XDG_CONFIG_HOME="$HOME/.config"

## k8s (completion regenerated when the kubectl binary changes)
if (( $+commands[kubectl] )); then
  [[ -z $_zsh_cache_refresh && $_zsh_cache/kubectl.zsh -nt $commands[kubectl] ]] || kubectl completion zsh >|"$_zsh_cache/kubectl.zsh"
  source "$_zsh_cache/kubectl.zsh"
  compdef _kubectl k
fi
{{- if $mac }}

export PATH=$PATH:~/.local/bin
{{- end }}
[[ ! -f ~/.kubecm ]] || source ~/.kubecm
{{- if $mac }}

# lib C installed by homebrew (SDK path cached; reload-zsh after an Xcode change)
export LIBRARY_PATH="$HOMEBREW_PREFIX/lib:/usr/lib"
[[ -z $_zsh_cache_refresh && -s $_zsh_cache/sdk-path ]] || xcrun --show-sdk-path >|"$_zsh_cache/sdk-path" 2>/dev/null
export CPATH="$HOMEBREW_PREFIX/include:$(<"$_zsh_cache/sdk-path")/usr/include"
{{- end }}

## golang: binaries from `go install` (Go's default GOPATH; `go env GOPATH` cost ~15ms per shell)
(( $+commands[go] )) && export PATH="$PATH:${GOPATH:-$HOME/go}/bin"
{{- if has "direnv" $t }}

## direnv (native hook)
_cached_init direnv hook zsh && source $REPLY
{{- end }}
{{- if has "fzf" $t }}

## fzf
source "$HOME/.config/zsh/fzf.zsh"
source "$HOME/.config/zsh/git-push.zsh" # git-push <Tab>: pick repos with commits to push
{{- end }}
{{- if has "starship" $t }}

## prompt
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
_cached_init starship init zsh && source $REPLY
{{- end }}
{{- if has "zoxide" $t }}

## cd
_cached_init zoxide init zsh && source $REPLY
alias cd="z"
{{- end }}
{{- if $mac }}

## file manager
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}
{{- end }}

# restart-zsh: the refresh flag came in exported. Unset it so child shells don't regenerate
# the caches too, and rebuild the dot index like reload-zsh (which sets it unexported).
if [[ ${(t)_zsh_cache_refresh} == *export* ]]; then
  unset _zsh_cache_refresh
  (( $+functions[_dot_index] )) && _dot_index -q
fi
