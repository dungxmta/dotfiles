[user]
	name = dungx

{{- if eq .chezmoi.os "darwin" }}
[url "git@gitlab:"]
    insteadOf = git@gitlab.com:
    insteadOf = https://gitlab.com/

# Only SSH URLs are rewritten: https://github.com/ clones (oh-my-zsh, tpm, a fresh
# dotfiles bootstrap) keep working before this Mac has a GitHub key.
[url "git@github:"]
    insteadOf = git@github.com:
{{- else }}
# https://github.com/ is rewritten for push only: public clones (oh-my-zsh, tpm,
# lazy.nvim plugins) work before this machine has a GitHub key or agent.
[url "git@github:"]
    insteadOf = git@github.com:
    pushInsteadOf = https://github.com/
{{- end }}

; system configs

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[color]
	ui = true

[alias]
	st = status -sb
	co = checkout
	c = commit --short
	ci = commit --short
	p = push
	l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --decorate --date=short

[core]
{{- if has "delta" .tools }}
	pager = delta
{{- end }}
	; pager = difft
	preloadindex = true
	untrackedcache = true

{{- if has "delta" .tools }}

[interactive]
	diffFilter = delta --color-only
{{- end }}

[delta]
	navigate = true    # use n and N to move between diff sections
	light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
	side-by-side = false 
	line-numbers = true
	tabs = 2
	features = decorations

; Merge with diffview or nvimdiff (default is vimdiff)
[merge]
	conflictStyle = diff3
	tool = diffview
	; tool = nvimdiff
	
[mergetool]
	prompt = false
	keepBackup = false

[mergetool "diffview"]
	cmd = ~/.config/zsh/script/git-mergetool-diffview.sh

[mergetool "nvimdiff"]
	layout = "LOCAL,BASE,REMOTE / MERGED"

[diff]
	colorMoved = default
	context = 5

[pull]
	rebase = true

[github]
	user = dungxmta 

; [commit]
; 	gpgsign = true

[credential]
	helper = cache

[rebase]
	autoStash = true

; [credential "https://github.com"]
; 	helper = 
; 	helper = !/usr/bin/gh auth git-credential

; [credential "https://gist.github.com"]
; 	helper = 
; 	helper = !/usr/bin/gh auth git-credential

[log]
	showSignature = true
[fetch]
	prune = true

[init]
	defaultBranch = main

# Don't treat a folder as a bare repository just because you cd into it: its
# config (core.pager, core.fsmonitor…) could run commands. Use --git-dir for
# bare repos.
[safe]
	bareRepository = explicit
