# docs
# ---
# ghostty +show-config --default --docs | nvim
# examples:
# https://github.com/search?q=path%3Aghostty%2Fconfig&type=code

# ghostty +list-fonts
# font-family = Berkeley Mono
# font-family = Symbols Nerd Font Mono
# font-family = JetBrainsMono Nerd Font Mono
# font-family-italic = "Maple Mono"
# font-family-bold-italic = "Maple Mono"
# window-title-font-family = "Maple Mono"
# font-style = bold
font-feature = +zero +ss02 +cv04 +cv16 +cv18 +cv19 +cv20
font-size = 13
adjust-cell-height = 20%
# TODO: https://github.com/ghostty-org/ghostty/discussions/3492
# font-thicken = true

# patch font symbol (make icon bigger)
font-codepoint-map = U+23FB-U+23FE,U+2665,U+26A1,U+2B58,U+E000-U+E00A,U+E0A0-U+E0A3,U+E0B0-U+E0D4,U+E200-U+E2A9,U+E300-U+E3E3,U+E5FA-U+E6AA,U+E6B2,U+E700-U+E7C5,U+EA60-U+EBEB,U+F000-U+F2E0,U+F300-U+F32F,U+F400-U+F4A9,U+F500-U+F8FF,U+F0001-U+F1AF0=Symbols Nerd Font Mono
font-codepoint-map = U+E000-U+F8FF,U+F0000-U+FFFFF,U+100000-U+10ffff=JetBrainsMonoNL Nerd Font

# cursor
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true
mouse-shift-capture = true
# mouse-scroll-multiplier = 2

# clipboard
clipboard-read = allow
clipboard-paste-protection = false
copy-on-select = clipboard

# windows
macos-option-as-alt = true
# confirm-close-surface = false
quit-after-last-window-closed = true
window-save-state = always

shell-integration-features = cursor,sudo,title

gtk-titlebar = false
gtk-single-instance = true

macos-window-shadow = false
macos-titlebar-style=hidden

window-padding-x = 2
window-padding-y = 0,0
window-padding-balance = true 
# tmux bar at the bottom: https://github.com/ghostty-org/ghostty/issues/2133
window-padding-color = background

# colorscheme
# ---
window-theme = dark
cursor-invert-fg-bg = true
unfocused-split-opacity = 1

background-opacity = 0.96
background-blur-radius = 10

# ghostty +list-themes
theme = kanagawabones

# keybindings
# ---
# similar to tmux with prefix: cmd+s
keybind = cmd+s>r=reload_config
keybind = cmd+s>x=close_surface
keybind = cmd+s>n=new_window
# tabs 
keybind = cmd+s>c=new_tab
keybind = cmd+s>shift+l=next_tab
keybind = cmd+s>shift+h=previous_tab
keybind = cmd+s>comma=move_tab:-1
keybind = cmd+s>period=move_tab:1
# quick tab switch
keybind = cmd+s>1=goto_tab:1
keybind = cmd+s>2=goto_tab:2
keybind = cmd+s>3=goto_tab:3
keybind = cmd+s>4=goto_tab:4
keybind = cmd+s>5=goto_tab:5
keybind = cmd+s>6=goto_tab:6
keybind = cmd+s>7=goto_tab:7
keybind = cmd+s>8=goto_tab:8
keybind = cmd+s>9=goto_tab:9
# split
keybind = cmd+s>\=new_split:right
keybind = cmd+s>-=new_split:down

keybind = cmd+s>j=goto_split:bottom
keybind = cmd+s>k=goto_split:top
keybind = cmd+s>h=goto_split:left
keybind = cmd+s>l=goto_split:right

keybind = cmd+s>z=toggle_split_zoom

keybind = cmd+s>e=equalize_splits
