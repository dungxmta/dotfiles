
;; source layout

(defsrc
esc     f1      f2      f3      f4      f5      f6      f7      f8      f9      f10     f11     f12
grv     1       2       3       4       5       6       7       8       9       0       -       =       bspc
tab     q       w       e       r       t       y       u       i       o       p       [       ]       \ 
caps    a       s       d       f       g       h       j       k       l       ;       '       ret
lsft    z       x       c       v       b       n       m       ,       .       /       rsft
lctl    lmet    lalt                    spc                     ralt    rmet    rctl
)

(defvar
      tap-time 200
      hold-time 200
      hold-time-slow 300
)

;; custom alias

;; cec: Caps as Escape (tap) and Control (hold)
;; use _ mean use default key
(defalias
        cec (tap-hold $tap-time $hold-time esc lctl)
        numnav (tap-hold $tap-time $hold-time _ (layer-toggle numnav))
        sym (tap-hold $tap-time $hold-time _ (layer-toggle sym))

        ;; home-rows-mod
        hs (tap-hold $tap-time $hold-time _ lsft)
        hc (tap-hold $tap-time $hold-time _ lctl)
        ha (tap-hold $tap-time $hold-time _ lalt)
        hm (tap-hold $tap-time $hold-time _ lmet)
        hrs (tap-hold $tap-time $hold-time _ rsft)
        hrc (tap-hold $tap-time $hold-time _ rctl)
        hra (tap-hold $tap-time $hold-time _ ralt)
        hrm (tap-hold $tap-time $hold-time _ rmet)
        
        tmeh (tap-hold $tap-time $hold-time _ (multi ctl alt sft))
        tasm (tap-hold $tap-time $hold-time _ (multi alt met sft))
        thyp (tap-hold $tap-time $hold-time _ (multi ctl alt sft met))

        
)

;; combo
;;(defchordsv2
;;      (c v) (multi met v) 200 all-released () 
;;)

;; base layer

(deflayer base
esc     f1      f2      f3      f4      f5      f6      f7      f8      f9      f10     f11     f12
grv     1       2       3       4       5       6       7       8       9       0       -       =       bspc
tab     q       w       @numnav r       t       y       u       i       o       p       [       ]       \
@cec    @ha     @hc     @hm     @hs     g       h       @hrs    @hrm    @hrc    @hra    '       ret
lsft    z       x       c       v       b       n       m       ,       .       /       rsft
lctl    lmet    lalt                    @tmeh                   ralt    rmet    rctl
)


;; symbol layer
;; S- represents Shift, so S-1 outputs !, S-2 outputs @, etc.

(deflayer numnav
  _       _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _       _       _       _       home    pgdn    pgup    end     _       _       _       _
  _       _       _       _       _       _       left    down    up      rght    _       _       _ 
  _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _                       _                       _       _       _
)


(deflayer sym
  _       _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _       _       _
  _       _       S-1     S-2     S-3     [       ]       -       =       \       _       _       _       _
  _       `       S-4     S-5     S-6     S-[     S-]     S--     S-=     S-\     S-;     _       _ 
  _       S-`     S-7     S-8     S-9     S-9     S-0     S-0     S-,     S-.     S-/     _
  _       _       _                       _                       _       _       _
)


(deflayer app
  _       _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _       _ 
  _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _                       _                       _       _       _
)


(deflayer empty
  _       _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _       _       _       _       _       _       _       _       _       _       _ 
  _       _       _       _       _       _       _       _       _       _       _       _
  _       _       _                       _                       _       _       _
)

